// Prisma Schema for EFCPL Inventory & Manufacturing Execution System (MES)
// 2 Main Sections: INVENTORY (RM, PM) & OPERATIONS (RM Issue, Production, Packaging Issue, Finished Goods, Dispatch)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. SYSTEM LOOKUPS & CONFIGURATION
// ==========================================

model SystemLookup {
  id        String   @id @default(cuid())
  group     String   // "UNIT", "COA_STATUS", "LOCATION", "BRAND"
  code      String   // "KG", "LTR", "APPROVED", "ZONE_A"
  label     String   // "Kilograms (KG)", "Approved", "Cold Store Zone A"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([group, code])
  @@index([group])
}

model StorageLocation {
  id          String   @id @default(cuid())
  name        String   @unique
  zone        String
  tempSpec    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// 2. INVENTORY SECTION (Raw Materials & Packaging Materials)
// ==========================================

model RawMaterial {
  id           String    @id @default(cuid())
  code         String    // e.g. RM001 (allows multiple arrival entries for the same material code)
  name         String
  brand        String?
  batchNumber  String
  stock        Float     @default(0)
  unit         String    // e.g. KG, LTR, Units, Boxes
  reorderLevel Float     @default(0)
  maxStock     Float?
  supplier     String?
  location     String?
  expiryDate   DateTime?
  status       String    @default("Active") // Active, Low Stock, Expired
  attributes   Json?
  remarks      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([code])
  @@index([name])
  @@index([createdAt])
}

model PackagingMaterial {
  id           String    @id @default(cuid())
  code         String    @unique // e.g. PM001
  name         String
  brand        String?
  batchNumber  String
  stock        Float     @default(0)
  unit         String    @default("Units")
  reorderLevel Float     @default(0)
  maxStock     Float?
  supplier     String?
  location     String?
  expiryDate   DateTime?
  status       String    @default("Active")
  attributes   Json?
  remarks      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  pmIssues     PackagingIssue[]

  @@index([code])
  @@index([name])
}

// ==========================================
// 3. OPERATIONS SECTION (5 Dedicated Pipeline Tabs)
// ==========================================

// Tab 1: RM Issue
model RMIssue {
  id               String    @id @default(cuid())
  rmCode           String?
  materialName     String
  batchNumber      String
  issueFor         String    // FG Name / FG Code target
  expiryDate       DateTime?
  quantityInBatch  Float     @default(0)
  issuedStock      Float
  issuedDate       DateTime  @default(now())
  remarks          String?
  issuedBy         String    @default("Store Manager")
  createdAt        DateTime  @default(now())

  @@index([rmCode])
  @@index([issuedDate])
}

// Tab 2: Production Log
model ProductionLog {
  id               String   @id @default(cuid())
  fgCode           String   // e.g. FGPRO001
  fgName           String
  totalBatchesMade Int
  totalOutput      Float
  unit             String   @default("KG")
  wastage          Float    @default(0)
  mfgDate          DateTime // Form entry only
  expiryDate       DateTime // Form entry only
  remarks          String?  // Form entry only
  operator         String   @default("Supervisor")
  createdAt        DateTime @default(now())

  @@index([fgCode])
  @@index([createdAt])
}

// Tab 3: Packaging Issue
model PackagingIssue {
  id                String             @id @default(cuid())
  pmCode            String?
  packagingMaterial PackagingMaterial? @relation(fields: [pmCode], references: [code], onDelete: SetNull)
  pmName            String
  issueFor          String             // FG Target Name
  quantityInBatch   Float              @default(0)
  issuedQty         Float
  issuedDate        DateTime           @default(now())
  remarks           String?
  issuedBy          String             @default("Store Manager")
  createdAt         DateTime           @default(now())

  @@index([pmCode])
  @@index([issuedDate])
}

// Tab 4: Finished Goods (FG Master & Batch Stock)
model FinishedGood {
  id               String     @id @default(cuid())
  sku              String     @unique // FG Code / SKU
  name             String
  batchNumber      String
  quantityProduced Float      @default(0)
  totalStock       Float      @default(0)
  unit             String     @default("KG")
  mfgDate          DateTime
  expiryDate       DateTime
  shelfLifeDays    Int        // Auto-calculated: Expiry - MFG in days
  location         String?
  status           String     @default("In Stock")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  dispatches       Dispatch[]

  @@index([sku])
  @@index([batchNumber])
}

// Tab 5: Dispatch Log
model Dispatch {
  id            String        @id @default(cuid())
  skuCode       String?
  finishedGood  FinishedGood? @relation(fields: [skuCode], references: [sku], onDelete: SetNull)
  productName   String
  batchCode     String
  dispatchQty   Float
  dispatchDate  DateTime      @default(now())
  partyName     String        // Buyer / Client Name
  mfgDate       DateTime
  expiryDate    DateTime
  location      String?
  coaStatus     String        @default("Approved") // Approved, Pending, N/A
  remarks       String?
  dispatchedBy  String        @default("Dispatch Officer")
  createdAt     DateTime      @default(now())

  @@index([skuCode])
  @@index([dispatchDate])
}

// ==========================================
// 4. AUTHENTICATION & RBAC (DISCORD-STYLE ROLES & PERMISSIONS)
// ==========================================

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "inventory:rm:edit", "operations:production:create"
  label       String
  module      String   // "inventory", "operations_rm_issue", "operations_production", etc.
  action      String   // "view", "create", "edit", "delete"
  description String?

  rolePermissions RolePermission[]
}

model Role {
  id            String   @id @default(cuid())
  name          String   @unique // e.g. "Store Manager", "Production Supervisor"
  colorTag      String   @default("#3B82F6")
  description   String?
  isSystemAdmin Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rolePermissions RolePermission[]
  users           User[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model User {
  id            String     @id @default(cuid())
  username      String     @unique
  name          String
  passwordHash  String
  roleId        String?
  role          Role?      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  auditLogs     AuditLog[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  details   Json?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}
